{
  "name": "personal-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "tray:dev": "npm run dev --workspace=apps/tray",
    "tray:build": "npm run build --workspace=apps/tray",
    "typecheck": "npm run typecheck --workspace=apps/web && npm run typecheck --workspace=packages/types && npm run typecheck --workspace=apps/tray"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
