{
  "name": "personal-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web && npm run typecheck --workspace=packages/types",
    "test": "npm run test --workspace=packages/types && npm run test --workspace=apps/web",
    "tray:dev": "npm run dev --workspace=@personal-assistant/tray",
    "tray:build": "npm run build --workspace=@personal-assistant/tray"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
