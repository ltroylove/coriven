# Coriven — environment variable template
# Copy to .env.local for local dev; set the same vars in Vercel for production.
# NEVER commit .env.local. Full setup steps: docs/setup/cloud-services-setup.md
# Secrets must NOT use the NEXT_PUBLIC_ prefix (that exposes them to the browser).

# ─────────────────────────────────────────────────────────────
# PHASE 1 — required now (Epic 1: deploy + run)
# ─────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret — server only

# Anthropic → console.anthropic.com (chat + extraction)
ANTHROPIC_API_KEY=                    # secret

# App URL (production: https://coriven.app ; local dev: http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Cron auth (set now; used from Epic 4). Generate: openssl rand -hex 32
CRON_SECRET=                          # secret

# ─────────────────────────────────────────────────────────────
# PHASE 2 — Persistent Memory (Epic 2)
# pgvector is a DB extension (no env var) — enabled via migration/dashboard
# ─────────────────────────────────────────────────────────────
# OpenAI → platform.openai.com (embeddings: text-embedding-3-small)
OPENAI_API_KEY=                       # secret

# Upstash Redis → upstash.com (Sentinel tier-1 cache, ~1ms vs Supabase ~10ms)
# DEFERRED — Supabase sentinel_context is the active store; Upstash skipped gracefully
# when these are absent. Add only if sub-10ms read latency becomes a measured need.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=           # secret

# ─────────────────────────────────────────────────────────────
# PHASE 5 — Communications Intelligence (Epic 5)
# ─────────────────────────────────────────────────────────────
# Nango (self-hosted OAuth authority — ADR-013)
# Deploy runbook: docs/implementation/runbooks/nango-setup.md
NANGO_SECRET_KEY=                     # secret — Nango environment API key (Environment Settings → API Keys)
NANGO_HOST=                           # base URL of your self-hosted Nango instance (e.g. https://nango.example.com)

# ─────────────────────────────────────────────────────────────
# PHASE 7 — Productization (Epic 7) — Stripe via MealPrepForge LLC
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                    # secret — account-wide (shared w/ PrepForge)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=                # secret — per-endpoint (Coriven's own)
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_LIFETIME=

# Web Push / VAPID (PWA mobile push). Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # secret
VAPID_SUBJECT=                        # e.g. mailto:you@example.com
